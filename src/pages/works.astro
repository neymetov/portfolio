---
import { getEntry, getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import WorkBanner from '../components/WorkBanner.astro';
import WorkCard from '../components/WorkCard.astro';
import WorksFilter from '../components/WorksFilter.tsx';

// Страница `all works` (фрейм 527:2004): заголовок, ряд табов рубрик и блоки работ.
//
// Состав страницы задают сами работы: поле «Как показывать на /works» (wide / split / small)
// и «Порядок сортировки». Страница идёт по работам по порядку и склеивает блоки:
//   wide  — широкая карточка с названием и описанием, отдельным блоком;
//   banner — то же во всю ширину, но без подписи: одно изображение;
//   split — половина ширины, копится в баннеры по две;
//   small — копится в ряд (на десктопе четыре укладываются ровно в ширину контента).
// Так редактор управляет и составом, и порядком, а вёрстка не знает заранее ни числа блоков,
// ни числа карточек в них.
const page = (await getEntry('worksPage', 'works'))!.data;

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);

const categories = (await getCollection('categories')).sort(
  (a, b) => a.data.order - b.data.order,
);

type Work = (typeof works)[number];
type Block =
  | { kind: 'wide'; works: [Work] }
  | { kind: 'banner'; works: [Work] }
  | { kind: 'split'; works: Work[] }
  | { kind: 'small'; works: Work[] };

const blocks: Block[] = [];

for (const work of works) {
  const size = work.data.cardSize;

  // Широкие блоки всегда стоят отдельно и ни с чем не склеиваются.
  if (size === 'wide' || size === 'banner') {
    blocks.push({ kind: size, works: [work] });
    continue;
  }

  const last = blocks.at(-1);
  // Продолжаем предыдущий блок того же вида, пока он не заполнен: split — до двух карточек,
  // small — сколько угодно (ряд листается, если не влезает).
  const canContinue =
    last?.kind === size && (size === 'small' || last.works.length < 2);

  if (canContinue) last.works.push(work);
  else blocks.push({ kind: size, works: [work] });
}

const tags = (work: Work) => work.data.categoryTags.map((tag) => tag.id).join(' ');
---

<Base title={`${page.title} — Elshan Neymatov`}>
  <div class="page-header">
    <div class="head">
      <h1 class="t-h1">{page.title}</h1>
    </div>
    <div class="tab-row">
      <WorksFilter
        client:idle
        categories={categories.map((category) => ({ id: category.id, title: category.data.title }))}
      />
    </div>
  </div>

  {
    blocks.map((block) =>
      block.kind === 'wide' || block.kind === 'banner' ? (
        <section class="block" data-works-row>
          <div data-work-categories={tags(block.works[0])}>
            {block.kind === 'wide' ? (
              <FeaturedWork work={block.works[0]} />
            ) : (
              <WorkBanner work={block.works[0]} />
            )}
          </div>
        </section>
      ) : (
        <section class="block" data-works-row>
          <ul class:list={['hscroll', 'row', `row-${block.kind}`]}>
            {block.works.map((work) => (
              <li data-work-categories={tags(work)}>
                <WorkCard work={work} />
              </li>
            ))}
          </ul>
        </section>
      ),
    )
  }
</Base>

<style>
  /* Заголовок и ряд табов: отступы по краям — margin, вертикальные — m (16 из макета). */
  .head,
  .tab-row {
    padding: var(--space-m) var(--space-margin);
  }

  /* Блоки работ: вертикальные отступы x (24 моб / 32 десктоп). */
  .block {
    padding: var(--space-x) var(--space-margin);
  }

  /*
    Смена рубрики: блок уезжает в сторону и возвращается с противоположной.
    Сдвиг небольшой (space-x), чтобы переход читался, но не отвлекал.
    Состояния in-* выставляют стартовое смещение без перехода — его снимает следующий кадр.
  */
  .block {
    transition:
      opacity 180ms ease,
      transform 260ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .block[data-anim='out-left'],
  .block[data-anim='in-left'] {
    opacity: 0;
    transform: translateX(calc(-1 * var(--space-x)));
  }

  .block[data-anim='out-right'],
  .block[data-anim='in-right'] {
    opacity: 0;
    transform: translateX(var(--space-x));
  }

  .block[data-anim^='in-'] {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .block {
      transition: none;
    }
  }

  /*
    Ряды тянутся до правого края экрана: на мобильном карточки уходят под кромку и ряд
    листается, на десктопе ряд укладывается ровно (4×302 + 3×24 = 1280 и 2×628 + 24 = 1280).
  */
  .row {
    /* Зазор между карточками: 16 на мобильном, 24 на десктопе. */
    --row-gap: var(--space-l);
    margin-right: calc(-1 * var(--space-margin));
  }

  /* Спейсер гасит собственный gap, иначе ряд оказывается на один зазор шире нужного
     и «скроллится» там, где по макету должен укладываться ровно. */
  .row::after {
    content: '';
    flex: none;
    width: var(--space-margin);
    margin-left: calc(-1 * var(--row-gap));
  }

  .row-small {
    --card-width: var(--bento-w-s);
  }

  /*
    В парных блоках зазор 24 на обеих раскладках, поэтому на мобильном это space-x,
    а на десктопе space-l — в мелком ряду зазор остаётся 16/24.
  */
  .row-split {
    --card-width: var(--bento-w-l);
    --row-gap: var(--space-x);
  }

  /* Скрытые фильтром элементы не должны оставлять зазор в ряду. */
  .row li[hidden] {
    display: none;
  }

  @media (min-width: 1024px) {
    .row-split {
      --row-gap: var(--space-l);
    }

    /*
      Карточки в рядах имеют фиксированную ширину из bento-токенов, поэтому на экранах шире
      1440 ряд узок и без выравнивания липнет к левому краю, тогда как широкая карточка тянется
      на всю ширину. Центрируем ряд; safe center нужен, чтобы при большом числе карточек
      ряд снова листался от левого края, а не обрезался с обеих сторон.
    */
    .row {
      justify-content: safe center;
      margin-right: 0;
    }

    .row::after {
      display: none;
    }
  }
</style>
