---
import type { CollectionEntry } from 'astro:content';
import Chip from './Chip.astro';
import { monthYear } from '../utils/format';

// Широкая работа (фрейм work_hero): два блока рядом — текст и квадратное изображение.
// Раньше панель с текстом лежала поверх картинки, из-за чего на десктопе и мобильном
// обложка кадрировалась по-разному; теперь изображение всегда квадратное и не обрезается.
//
// desktop — две равные колонки: текст слева, квадратная обложка справа. Текст закреплён
//           sticky и едет с прокруткой, пока не упрётся в нижний край обложки;
// mobile  — текст сверху, картинка под ним во всю ширину.
interface Props {
  work: CollectionEntry<'works'>;
  // На /works карточка ведёт на проект и её название — h2; на самой странице проекта
  // ссылка не нужна, а название становится заголовком страницы.
  heading?: 'h1' | 'h2';
}

const { work, heading = 'h2' } = Astro.props;
const { title, shortDescription, heroImage, date } = work.data;

const Wrapper = heading === 'h1' ? 'div' : 'a';
const Title = heading;

// В шапке проекта под названием стоит тег с датой: месяц и год, без дня.
// В списке работ на /works даты нет — там карточка ведёт на проект.
const dateLabel = heading === 'h1' ? monthYear(date) : null;
---

<Wrapper class="featured" href={heading === 'h1' ? undefined : `/work/${work.id}`}>
  <div class="info">
    <Title class="t-h4 title">{title}</Title>
    {dateLabel && <Chip label={dateLabel} />}
    {shortDescription && <p class="t-p2 caption">{shortDescription}</p>}
  </div>

  <figure class="cover">
    <img class="media" src={heroImage} alt={title} />
  </figure>
</Wrapper>

<style>
  .featured {
    display: grid;
    gap: var(--space-s);
    align-items: center;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    align-self: start;
  }

  .title {
    color: var(--color-neutral-800);
  }

  .caption {
    color: var(--color-neutral-500);
  }

  /* Плашка с датой не тянется на всю колонку. */
  .info :global(.chip) {
    align-self: flex-start;
  }

  .cover {
    margin: 0;
    overflow: clip;
    border-radius: var(--radius-xxl);
  }

  /* Обложка всегда квадратная — одинаково кадрируется на обеих раскладках. */
  .media {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 0;
  }

  @media (min-width: 1024px) {
    /* Два равных квадрата: при ширине контента 1280 колонки выходят по 628, как в макете. */
    .featured {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-l);
    }

    /*
      Текст начинается на одной высоте с обложкой и прилипает при прокрутке.
      Дальше нижнего края обложки он не уедет: sticky ограничен высотой этой строки грида.
      Отступ сверху небольшой — навбар при прокрутке показывает только кнопку справа,
      а текст стоит слева и с ней не пересекается.
    */
    .info {
      align-self: start;
      position: sticky;
      top: var(--space-xl);
    }
  }
</style>
