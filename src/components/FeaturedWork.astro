---
import type { CollectionEntry } from 'astro:content';

// Главная работа на /works (Component 2 в макете): изображение на всю карточку, поверх него
// панель neutral-50 с названием (h4) и описанием (p2).
//
// desktop — панель справа по центру, шириной 580 (628 − padding), высота карточки 628;
// mobile  — панель прижата к низу на всю ширину, высота карточки 523.
interface Props {
  work: CollectionEntry<'works'>;
  // На /works карточка ведёт на проект и её название — h2; на самой странице проекта
  // ссылка не нужна, а название становится заголовком страницы.
  heading?: 'h1' | 'h2';
}

const { work, heading = 'h2' } = Astro.props;
const { title, shortDescription, heroImage } = work.data;

const Wrapper = heading === 'h1' ? 'div' : 'a';
const Title = heading;
---

<Wrapper class="featured" href={heading === 'h1' ? undefined : `/work/${work.id}`}>
  <img class="bg" src={heroImage} alt={title} />
  <div class="info">
    <Title class="t-h4 title">{title}</Title>
    {shortDescription && <p class="t-p2 caption">{shortDescription}</p>}
  </div>
</Wrapper>

<style>
  .featured {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: clip;
    /* Высота карточки: 523 на мобильном (bento-h-xxl), 628 на десктопе (bento-h-banner). */
    height: var(--bento-h-xxl);
    padding: var(--space-l);
    border-radius: var(--radius-xxl);
  }

  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    position: relative;
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    gap: var(--space-m);
    min-width: 0;
    padding: var(--space-xl);
    border-radius: var(--radius-xxl);
    background: var(--color-neutral-50);
  }

  .title {
    color: var(--color-neutral-800);
  }

  .caption {
    color: var(--color-neutral-500);
  }

  @media (min-width: 1024px) {
    .featured {
      align-items: center;
      justify-content: flex-end;
      height: var(--bento-h-banner);
      padding: var(--space-xl);
    }

    .info {
      flex: none;
      height: 100%;
      /* 580 из макета = ширина парной карточки минус внутренний отступ. */
      width: calc(var(--bento-w-l) - var(--space-xl));
    }
  }
</style>
