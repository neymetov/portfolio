---
import type { CollectionEntry } from 'astro:content';
import { listCover } from '../utils/work';

// Широкая работа без подписи: только изображение во всю ширину контента.
// Пропорции те же, что у широкой карточки с панелью, — 1280×628 на десктопе,
// 343×523 на мобильном, чтобы ряды соседних блоков не сбивались по высоте.
interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title } = work.data;
const cover = listCover(work);
---

<a class="banner" href={`/work/${work.id}`}>
  <img class="media" src={cover.src} alt={title} loading="lazy" />
    {
      cover.video && (
        <video
          class="media video"
          src={cover.video}
          poster={cover.src}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        />
      )
    }
</a>

<style>
  .banner {
    position: relative;
    display: block;
    overflow: clip;
    height: var(--bento-h-xxl);
    border-radius: var(--radius-xxl);
  }

  .media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  /*
    Видео лежит поверх постера: пока оно грузится, виден статичный кадр,
    а при выключенной анимации остаётся только он.
  */
  .video {
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .video {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .banner {
      height: var(--bento-h-banner);
    }
  }
</style>
