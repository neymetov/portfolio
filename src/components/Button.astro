---
// Кнопка-ссылка из макета. Варианты заливки описаны классами .btn-* в global.css:
// primary — neutral-800 с текстом neutral-50 (CTA футера);
// secondary — neutral-900 с рамкой neutral-700 и chevron (переход в раздел);
// soft — neutral-200 с рамкой neutral-300 (второстепенное действие рядом с secondary).
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'soft';
  external?: boolean;
}

const { href, label, variant = 'primary', external = false } = Astro.props;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a class:list={['btn', `btn-${variant}`]} href={href} rel={rel} target={target}>
  <span>{label}</span>
  {
    variant === 'secondary' && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M9.5 7l5 5-5 5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>
