---
// Кнопка-ссылка из макета. Два вида, состояния описаны классами .btn-* в global.css:
// dark — основное действие; light — второстепенное, рядом с тёмной.
// Chevron ставится отдельным флагом: он нужен переходам в раздел, а не всем тёмным кнопкам.
interface Props {
  href: string;
  label: string;
  variant?: 'dark' | 'light';
  chevron?: boolean;
  external?: boolean;
}

const { href, label, variant = 'dark', chevron = false, external = false } = Astro.props;
const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a class:list={['btn', `btn-${variant}`]} href={href} rel={rel} target={target}>
  <span>{label}</span>
  {
    chevron && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M9.5 7l5 5-5 5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>
