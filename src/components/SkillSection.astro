---
import type { CollectionEntry } from 'astro:content';

// skill-section из фреймов 539:2023 (desktop) и 539:2290 (mobile).
// Карточки намеренно не кликабельны: это описание роли, а не навигация.
//
// desktop — сетка 3×N; skill-caption скрыт и раскрывается внутри карточки при наведении:
//           текстовый блок растёт вверх, поэтому высота карточки и сетка не меняются;
// mobile  — одна колонка, caption виден сразу, а карточки при скролле наплывают друг
//           на друга: каждая липнет к верху с небольшим каскадом, следующая накрывает предыдущую.
//
// Оба поведения на CSS — скриптов здесь нет.
interface Props {
  title: string;
  cards: CollectionEntry<'skills'>[];
}

const { title, cards } = Astro.props;
---

<section class="section skills" id="what-i-can-do">
  <h2 class="t-h1">{title}</h2>

  <ul class="list">
    {
      cards.map((skill, index) => (
        <li class="card" style={`--i: ${index}`}>
          <img class="icon" src={skill.data.icon} alt="" loading="lazy" />
          <div class="info">
            <h3 class="t-h4 title">{skill.data.title}</h3>
            <div class="caption">
              <p class="t-p2 caption-text">{skill.data.description}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
  }

  .card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-xl);
    border-radius: var(--radius-xxl);
    background: var(--color-neutral-100);
  }

  .icon {
    width: 156px;
    height: 156px;
    object-fit: contain;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .title {
    color: var(--color-neutral-800);
  }

  .caption-text {
    color: var(--color-neutral-500);
  }

  /*
    Наплыв на мобильном: карточка липнет к верху экрана под навбаром, а следующая
    проезжает поверх неё. Каскад по --i оставляет видимой кромку нижних карточек.
    z-index по порядку не нужен — более поздний элемент и так рисуется выше.
  */
  @media (max-width: 1023px) {
    .list {
      gap: var(--space-l);
    }

    .card {
      position: sticky;
      top: calc(var(--space-xl) + var(--i) * var(--space-s));
    }
  }

  @media (min-width: 1024px) {
    /* Три в ряд: при двух колонках квадратные карточки получались слишком крупными. */
    .list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /*
      Высота карточки постоянна и не зависит от состояния: отступы + иллюстрация + место
      под заголовок в четыре строки. Описание в расчёт не входит — оно раскрывается внутри.
    */
    .card {
      position: relative;
      height: calc(3 * var(--space-xl) + 156px + 4 * var(--line-height-h4));
      overflow: clip;
    }

    /* Более длинный заголовок обрезается, а не наезжает на иллюстрацию. */
    .title {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
      overflow: hidden;
    }

    /*
      Текстовый блок закреплён по нижнему краю, поэтому при раскрытии описания он растёт
      вверх — заголовок поднимается, а не уезжает за границу карточки.
    */
    .info {
      position: absolute;
      inset: auto var(--space-xl) var(--space-xl);
    }

    /*
      При наведении текст поднимается на место иллюстрации, поэтому она уходит —
      иначе длинный заголовок наезжал бы на неё.
    */
    .icon {
      transition: opacity 200ms ease;
    }

    .card:hover .icon,
    .card:focus-within .icon {
      opacity: 0;
    }

    .caption {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 320ms cubic-bezier(0.22, 0.8, 0.36, 1);
    }

    .caption-text {
      overflow: hidden;
      opacity: 0;
      transition: opacity 200ms ease;
    }

    .card:hover .caption,
    .card:focus-within .caption {
      grid-template-rows: 1fr;
    }

    .card:hover .caption-text,
    .card:focus-within .caption-text {
      opacity: 1;
      transition-delay: 80ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .caption,
    .caption-text {
      transition-duration: 0ms;
    }
  }
</style>
