---
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Chip from './Chip.astro';
import { monthYear } from '../utils/format';

// Карточка работы: квадратная картинка, под ней название (p1), описание (p3) и тег рубрики.
// Тег в покое скрыт и при наведении съезжает сверху вниз; место под него зарезервировано,
// поэтому высота карточки не меняется и сетка не дёргается.
// Ширину карточки задаёт ряд-родитель.
interface Props {
  work: CollectionEntry<'works'>;
  // Что показывать в плашке: рубрику (по умолчанию) или дату проекта.
  chip?: 'category' | 'date';
}

const { work, chip = 'category' } = Astro.props;
const { title, shortDescription, heroImage, categoryTags, date } = work.data;

// Рубрик у работы может быть несколько, но плашка в макете одна — берём первую.
const [firstTag] = categoryTags;
const category = chip === 'category' && firstTag ? await getEntry(firstTag) : undefined;
const chipLabel = chip === 'date' ? monthYear(date) : category?.data.title;
---

<a class="work" href={`/work/${work.id}`}>
  <figure class="cover">
    <img class="media ratio-square" src={heroImage} alt={title} loading="lazy" />
  </figure>

  <div class="info">
    <div class="text">
      <p class="t-p1 title">{title}</p>
      {shortDescription && <p class="t-p3 caption">{shortDescription}</p>}
    </div>

    {
      chipLabel && (
        <div class="chip-slot">
          <Chip label={chipLabel} />
        </div>
      )
    }
  </div>
</a>

<style>
  .work {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  /* Рамка обрезает картинку, поэтому при наведении она увеличивается внутри карточки. */
  .cover {
    margin: 0;
    overflow: clip;
    border-radius: var(--radius-xxl);
  }

  .media {
    border-radius: 0;
    transition: transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .work:hover .media,
  .work:focus-visible .media {
    transform: scale(1.04);
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .text {
    display: flex;
    flex-direction: column;
  }

  .title {
    color: var(--color-neutral-800);
  }

  /* Описание не длиннее двух строк — дальше многоточие, чтобы карточки в ряду были ровными. */
  .caption {
    color: var(--color-neutral-500);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  /* Место под плашку занято всегда, а сама она выезжает из-за верхней кромки этой полосы. */
  .chip-slot {
    overflow: clip;
  }

  .chip-slot :global(.chip) {
    opacity: 0;
    transform: translateY(-100%);
    transition:
      opacity 400ms ease,
      transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .work:hover .chip-slot :global(.chip),
  .work:focus-visible .chip-slot :global(.chip) {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .media,
    .chip-slot :global(.chip) {
      transition: none;
    }

    .work:hover .media,
    .work:focus-visible .media {
      transform: none;
    }
  }
</style>
