---
import type { CollectionEntry } from 'astro:content';

// Карточка работы из фреймов `all works` и `Home`: квадратная картинка, под ней название (h5)
// и короткое описание (p2). Зазор между картинкой и подписью — space-l (16 моб / 24 десктоп).
// Ширину карточки задаёт ряд-родитель через --card-width, поэтому одна и та же карточка
// работает и в ряду мелких (302/164), и в парном блоке (628/343).
interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, shortDescription, heroImage } = work.data;
---

<a class="work" href={`/work/${work.id}`}>
  <figure class="cover">
    <img class="media ratio-square" src={heroImage} alt={title} loading="lazy" />
  </figure>
  <div class="info">
    <p class="t-h5 title">{title}</p>
    {shortDescription && <p class="t-p2 caption">{shortDescription}</p>}
  </div>
</a>

<style>
  .work {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
  }

  /* Рамка обрезает картинку, поэтому при наведении она увеличивается внутри карточки. */
  .cover {
    margin: 0;
    overflow: clip;
    border-radius: var(--radius-xxl);
  }

  .media {
    border-radius: 0;
    transition: transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .work:hover .media,
  .work:focus-visible .media {
    transform: scale(1.04);
  }

  .info {
    display: flex;
    flex-direction: column;
  }

  .title {
    color: var(--color-neutral-800);
  }

  /* Описание не длиннее двух строк — дальше многоточие, чтобы карточки в ряду были ровными. */
  .caption {
    color: var(--color-neutral-500);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .media {
      transition: none;
    }

    .work:hover .media,
    .work:focus-visible .media {
      transform: none;
    }
  }
</style>
